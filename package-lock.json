      "resolved": "packages/pkcs12",
      "link": true
    },
    "node_modules/@fitfak/qr": {
      "resolved": "packages/qr",
      "link": true
    },
    "node_modules/@fitfak/ssl": {
      "resolved": "packages/ssl",
